{
  "name": "andrewdyer/predis-request-limiter",
  "description": "A framework-agnostic PHP library for rate limiting requests using [Predis](https://github.com/predis/predis)",
  "keywords": [
    "php",
    "redis",
    "predis",
    "rate-limit",
    "framework-agnostic"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Dyer",
      "homepage": "https://andrewdyer.rocks",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/andrewdyer/predis-request-limiter",
  "support": {
    "issues": "https://github.com/andrewdyer/predis-request-limiter/issues",
    "source": "https://github.com/andrewdyer/predis-request-limiter"
  },
  "autoload": {
    "psr-4": {
      "AndrewDyer\\PredisRequestLimiter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewDyer\\PredisRequestLimiter\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "predis/predis": "^3.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
